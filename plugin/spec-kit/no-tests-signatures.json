{
  "version": 1,
  "description": "ADR-0022. Output that says a test runner ran no tests. A result is 'ran no tests' when some signature's pattern matches (re.MULTILINE, over stdout and stderr together) with the exit code in its exits, and no signature's positive pattern matches anywhere. Patterns are anchored so prose that quotes them does not count. ANSI escapes are stripped before matching. A malformed entry is skipped; the others still apply.",
  "signatures": [
    {"id": "pytest", "runner": "pytest",
     "pattern": "^=*[ \\t]*no tests ran\\b",
     "positive": "\\b[1-9]\\d* passed\\b",
     "exits": [0, 5]},
    {"id": "pytest-deselected", "runner": "pytest -k / -m that selects nothing",
     "pattern": "^=*[ \\t]*\\d+ deselected\\b",
     "positive": "\\b[1-9]\\d* passed\\b",
     "exits": [5]},
    {"id": "unittest", "runner": "python -m unittest",
     "pattern": "^Ran 0 tests in\\b",
     "positive": "^Ran [1-9]\\d* tests? in\\b",
     "exits": [0, 5]},
    {"id": "jest", "runner": "jest --passWithNoTests",
     "pattern": "^No tests found, exiting with code 0\\b",
     "positive": "^Tests:[ \\t].*\\b[1-9]\\d* passed\\b",
     "exits": [0]},
    {"id": "vitest", "runner": "vitest --passWithNoTests",
     "pattern": "^No test files found, exiting with code 0\\b",
     "positive": "^[ \\t]*Tests[ \\t]+.*\\b[1-9]\\d* passed\\b",
     "exits": [0]},
    {"id": "playwright", "runner": "playwright test --pass-with-no-tests",
     "pattern": "^(?:Error: )?No tests found\\.?[ \\t\\r]*$",
     "positive": "^[ \\t]*[1-9]\\d* passed\\b",
     "exits": [0]},
    {"id": "node-test", "runner": "node --test",
     "pattern": "^(?:#|ℹ) tests 0[ \\t\\r]*$",
     "positive": "^(?:#|ℹ) (?:tests|pass) [1-9]\\d*[ \\t\\r]*$",
     "exits": [0]},
    {"id": "mocha", "runner": "mocha",
     "pattern": "^[ \\t]*0 passing\\b",
     "positive": "^[ \\t]*[1-9]\\d* passing\\b",
     "exits": [0]},
    {"id": "go", "runner": "go test",
     "pattern": "^(?:\\?|ok)[ \\t]+\\S+[ \\t].*\\[no test(?: files|s to run)\\][ \\t\\r]*$",
     "positive": "^(?:ok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\])|--- PASS\\b)",
     "exits": [0]},
    {"id": "cargo", "runner": "cargo test",
     "pattern": "^running 0 tests[ \\t\\r]*$",
     "positive": "^running [1-9]\\d* tests?[ \\t\\r]*$",
     "exits": [0]}
  ]
}
